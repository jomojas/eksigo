# Copy to .env (local) or /opt/eab/.env (VPS). Never commit the real file.

# Public URL the apps use to reach this server (used to build dictionary download links).
EKSIGO_PUBLIC_BASE_URL=http://localhost:8000

# Signing in on the desktop (backend/README.md, "Desktop sign-in"). Leave out to switch a provider off.
# The client secret of the Google "Web application" OAuth client named in config.yaml (google_web_client_id).
# EKSIGO_GOOGLE_CLIENT_SECRET=
# The Sign in with Apple key (.p8) on one line, its line breaks written as \n. Used to revoke Apple sign-ins when an
# account is deleted.
# EKSIGO_APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----

# Local development only: lets POST /v1/auth/dev sign in without Apple or Google. Never set on the VPS.
# EKSIGO_DEV_LOGIN=1

# --- VPS only (docker compose) ---
# Domain pointing at the VPS. Caddy gets the HTTPS certificate for it automatically.
DOMAIN=api.example.com
# Image pushed by GitHub Actions (lowercase).
EKSIGO_IMAGE=ghcr.io/your-github-name/eksigo-backend:latest
