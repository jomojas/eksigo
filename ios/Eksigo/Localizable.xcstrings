        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컴퓨터에서 받아쓰기하며 단어를 저장하세요. 들었던 문장과 함께 여기로 와서 이동 중에 복습할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
