    },
    "Hold and drag to reorder. Each episode leaves the list when it starts. When the list is empty, playback stops after the current episode." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado y arrastra para reordenar. Cada episodio sale de la lista al empezar. Cuando la lista está vacía, la reproducción se detiene tras el episodio actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez et faites glisser pour réordonner. Chaque épisode quitte la liste quand il commence. Quand la liste est vide, la lecture s’arrête après l’épisode en cours."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長押ししてドラッグで並べ替え。再生が始まったエピソードはリストから消えます。リストが空になると、今のエピソードの後で再生が止まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "길게 눌러 끌면 순서가 바뀝니다. 재생이 시작된 에피소드는 목록에서 빠집니다. 목록이 비면 현재 에피소드 후 재생이 멈춥니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住拖动可调整顺序。每一集开始播放后会离开清单。清单为空时，当前这一集播完就停止。"
          }
        }
      }
    },
