    "Save words while you dictate on your computer. They come here with the sentence you heard them in, to review on the way." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda palabras mientras haces el dictado en el ordenador. Llegan aquí con la frase en que las oíste, para repasarlas de camino."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez des mots pendant la dictée sur l’ordinateur. Ils arrivent ici avec la phrase entendue, pour les réviser en route."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パソコンでディクテーションしながら単語を保存しましょう。聞いた文と一緒にここに届くので、移動中に復習できます。"
