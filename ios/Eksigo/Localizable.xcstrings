    "This podcast puts different ads in each download, so the sentence would play at the wrong spot here. Hear it on your computer." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este pódcast pone anuncios distintos en cada descarga, así que aquí la frase sonaría en otro punto. Escúchala en el ordenador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce podcast insère des pubs différentes à chaque téléchargement : la phrase serait lue au mauvais endroit ici. Écoutez-la sur l’ordinateur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このポッドキャストはダウンロードごとに広告が違うため、ここでは文がずれて再生されます。パソコンで聴いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 팟캐스트는 다운로드마다 광고가 달라서 여기서는 문장이 엉뚱한 곳에서 재생됩니다. 컴퓨터에서 들어 주세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个播客每次下载插入的广告都不同，所以在这里会播错位置。请在电脑上听。"
          }
        }
      }
    },
    "This removes %@ from Up Next." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto quita %@ de A continuación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela retire %@ d’À suivre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ を次に再生から削除します。"
          }
        },
        "ko" : {
