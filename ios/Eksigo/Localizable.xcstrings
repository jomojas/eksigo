    "What you listen to here and dictate on the computer shows up here, day by day." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que escuchas aquí y dictas en el ordenador aparece aquí, día a día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que vous écoutez ici et dictez sur l’ordinateur s’affiche ici, jour par jour."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここで聴いたものとパソコンでディクテーションしたものが、日ごとにここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기서 들은 것과 컴퓨터에서 받아쓴 것이 날짜별로 여기 표시됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在这里收听的和在电脑上听写的内容，会按天显示在这里。"
          }
        }
      }
    },
